<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>

  <!-- NuGet pack metadata (the gated SDK deliverable, dotnet pack -c Release). -->
  <PropertyGroup>
    <!-- W5 RULED 2026-08-30 by the owner: Febris.Simulation.XApiSdk IS the final
         PackageId (the former placeholder text, ruled as-is). pack.yml asserts the
         packed id equals this ruling, so an accidental rename here fails the
         publish audit. Trusted Publishing policy glob on nuget.org carries the
         same id. (Historical: the id was a placeholder pending the account-name
         decision; a de-branding rationale was corrected out 2026-08-28, brand
         stays Febris per Q17.) -->
    <PackageId>Febris.Simulation.XApiSdk</PackageId>
    <Version>0.1.0-preview</Version>
    <Authors>Febris</Authors>
    <Company>Febris</Company>
    <Description>On-device xAPI statement builder for simulations and games. Builds and updates xAPI 1.0.3 statements in-process -- no HTTP, no database -- and hands the emitted statement off to a host application via file drop or Android Intent.</Description>
    <!-- Apache-2.0 is the ratified license posture for the SDK tier
         (docs/OSS_SDK_DISTRIBUTION.md). The LICENSE file itself lands in the
         public SDK repo at extraction time (OSS_RELEASE_PLAN pipeline). The
         SPDX expression here is the package-level declaration. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!-- RepositoryUrl deliberately omitted: the workshop repo is private. The
         public URL is stamped by pack.yml at pack time (-p:RepositoryUrl from
         GITHUB_REPOSITORY), which is also what satisfies the publish audit's
         public-github-url requirement. (The earlier "set at extraction" plan
         was never implemented; the audit caught the empty value on the first
         real publish attempt, 2026-08-30.) -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- MDM-T2: expose internals to the parity / behavior test project so
         StatementCheck, ActorIsCorrect, MemberIsCorrect, AccountIsCorrect,
         AutoUpdateScaledScore, etc. can be tested directly instead of having
         to go through the public Initializer/StatementHandler entry points
         (which require an OS + Handler + parsed JObject and so are awkward
         to drive from a unit test). -->
    <InternalsVisibleTo Include="Febris.SimulationLibrary.Tests" />
  </ItemGroup>

</Project>
